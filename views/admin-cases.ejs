<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Deco Holdings | Recovery Cases</title>
    <link rel="stylesheet" href="/admin/assets/css/main/app.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/admin/assets/images/logo/favicon-32x32.png"
    />
  </head>
  <body>
    <div id="main" style="margin: 0; padding: 2rem">
      <div class="page-heading d-flex justify-content-between align-items-center">
        <h3>Recovery Cases</h3>
        <a href="<%= adminPath %>/users" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-arrow-left"></i> Dashboard
        </a>
      </div>

      <div class="page-content">
        <% if (!data.cases.length) { %>
        <div class="card"><div class="card-body text-center text-muted">No recovery cases yet.</div></div>
        <% } %>
        <% data.cases.forEach(function (c) { %>
        <div class="card">
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <h5>
                  <%= c.user ? c.user.fullname : "—" %>
                  <small class="text-muted">(<%= c.user ? c.user.email : "" %>)</small>
                </h5>
                <p class="mb-1"><strong>Asset:</strong> <%= c.asset %> — <%= c.amountLost %> <%= c.currency %></p>
                <% if (c.scamType) { %><p class="mb-1"><strong>Type:</strong> <%= c.scamType %></p><% } %>
                <% if (c.description) { %><p class="mb-1"><strong>Details:</strong> <%= c.description %></p><% } %>
                <% if (c.evidenceUrl) { %><p class="mb-1"><a href="<%= c.evidenceUrl %>" target="_blank">View evidence</a></p><% } %>
                <p class="mb-0 text-muted"><small>Submitted <%= c.createdAt.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %></small></p>
              </div>
              <div class="col-md-6">
                <form class="case-form" data-id="<%= c._id %>">
                  <div class="form-group mb-2">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-control">
                      <% ["submitted","under_review","in_progress","recovered","closed"].forEach(function (s) { %>
                      <option value="<%= s %>" <%= c.status === s ? "selected" : "" %>><%= s.replace('_',' ') %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="form-group mb-2">
                    <label class="form-label">Progress (%)</label>
                    <input type="number" name="progress" min="0" max="100" value="<%= c.progress %>" class="form-control" />
                  </div>
                  <div class="form-group mb-2">
                    <label class="form-label">Note to user</label>
                    <textarea name="adminNotes" rows="2" class="form-control"><%= c.adminNotes || '' %></textarea>
                  </div>
                  <button type="submit" class="btn btn-sm btn-primary">Save</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>

    <script>
      document.querySelectorAll(".case-form").forEach(function (form) {
        form.addEventListener("submit", async function (e) {
          e.preventDefault();
          const payload = {
            status: form.status.value,
            progress: form.progress.value,
            adminNotes: form.adminNotes.value,
          };
          try {
            const res = await fetch(
              "<%= adminPath %>/cases/" + form.getAttribute("data-id"),
              {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              }
            );
            if (!res.ok) throw new Error("failed");
            location.reload();
          } catch (err) {
            alert("Could not update case.");
          }
        });
      });
    </script>
  </body>
</html>
